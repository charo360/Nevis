# Crevo Environment Variables Template
# Copy this file to .env.local and fill in your values

# ===================================
# SITE CONFIGURATION (SEO)
# ===================================
NEXT_PUBLIC_SITE_URL=https://crevo.app
NEXT_PUBLIC_APP_URL=https://crevo.app

# Search Engine Verification Codes
NEXT_PUBLIC_GOOGLE_VERIFICATION=google65e938f40e1298ff
NEXT_PUBLIC_BING_VERIFICATION=your-bing-verification-code
NEXT_PUBLIC_YANDEX_VERIFICATION=your-yandex-verification-code

# ===================================
# SUPABASE
# ===================================
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ===================================
# AI SERVICES
# ===================================
# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Cloud / Vertex AI
GOOGLE_PROJECT_ID=your-google-project-id
GOOGLE_LOCATION=us-central1
VERTEX_AI_ENABLED=true
VERTEX_AI_CREDENTIALS=your-vertex-ai-credentials-json

# OpenAI (Optional)
OPENAI_API_KEY=your-openai-api-key

# OpenRouter Configuration for Website Analysis
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_HTTP_REFERER=http://localhost:3001
OPENROUTER_X_TITLE=Crevo AI Website Analyzer

# ===================================
# STRIPE (PAYMENTS)
# ===================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# ===================================
# SOCIAL MEDIA APIs (Direct Publishing)
# ===================================
# Meta (Facebook/Instagram) - Required for social publishing
# Get from: https://developers.facebook.com
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# Twitter/X (Optional)
# Get from: https://developer.twitter.com
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# LinkedIn (Optional)
# Get from: https://developer.linkedin.com
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# TikTok (Optional)
# Get from: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# ===================================
# ANALYTICS (Optional)
# ===================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ===================================
# MIXPOST INTEGRATION (Layer 6 - Delivery)
# ===================================
# Self-hosted Mixpost instance URL (e.g., https://mixpost.yourdomain.com)
MIXPOST_BASE_URL=https://your-mixpost-instance.com
# API token from Mixpost (Settings > API Tokens)
MIXPOST_API_TOKEN=your-mixpost-api-token
# Webhook secret for verifying Mixpost callbacks
MIXPOST_WEBHOOK_SECRET=your-webhook-secret

# ===================================
# CRON JOBS
# ===================================
# Secret for authenticating cron job requests
CRON_SECRET=your-cron-secret

# ===================================
# BUILD CONFIGURATION
# ===================================
NEXT_DIST_DIR=.next-alt
